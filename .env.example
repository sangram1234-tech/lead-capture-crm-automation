# Copy to .env and configure your SMTP provider. Email is logged as unavailable until set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SALES_EMAIL=sales@example.com
# Optional; defaults to lead_capture.db in the working directory.
DATABASE_PATH=lead_capture.db
